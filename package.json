{
  "name": "cypressframework",
  "version": "1.0.0",
  "description": "Cypress Framework build for WebUI and API Testing",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "uitest": "cross-env REPORT_NAME=UIReport cypress run --spec \"cypress/e2e/features/uiTest/**/*.feature\"",
    "apitest": "cross-env REPORT_NAME=APIReport cypress run --spec \"cypress/e2e/features/apiTest/**/*.feature,cypress/e2e/apiTest/**/*.feature,cypress/e2e/apiTest/**/*.spec.js\"",
    "cypress-dashboard": "npx cypress run --record --key 414d3363-6fe8-49db-ad55-3fcd3081d458",
    "dbtest": "cypress run --spec \"cypress/e2e/features/database/**/*.feature\""
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.js"
    ]
  },
  "author": "Emad Gendy",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^8.0.2",
    "jsonpath-plus": "^7.2.0",
    "mocha": "^10.2.0",
    "mysql": "^2.18.1"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^20.1.2",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.3",
    "cross-env": "^7.0.3",
    "cypress": "^13.1.0",
    "cypress-mochawesome-reporter": "^3.6.0",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "marge": "^1.0.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mysql2": "^3.6.1"
  },
  "allowScripts": {
    "cypress@13.1.0": true,
    "esbuild@0.19.12": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true
  }
}
